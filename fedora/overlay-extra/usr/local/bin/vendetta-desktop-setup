#!/bin/sh
set -u
id="${1:-}"
L=/var/log/vendetta-install.log
echo "=== vendetta-desktop-setup '$id' $(date -u) ===" >> "$L"

DNF="dnf -y --setopt=install_weak_deps=False"
case "$id" in
    kde|"") echo "KDE (or no choice) — nothing to install; done" >> "$L"; echo "DONE $(date -u)" >> "$L"; exit 0 ;;
    i3)       pkgs="xorg-x11-server-Xorg xorg-x11-xinit i3 i3status i3lock rofi feh dunst picom network-manager-applet"; sentinel="i3" ;;
    hyprland) pkgs="hyprland xdg-desktop-portal-hyprland waybar wofi mako swww grim slurp network-manager-applet"; sentinel="hyprland" ;;
    sway)     pkgs="sway swaybg waybar wofi mako grim slurp foot network-manager-applet"; sentinel="sway" ;;
    xfce)     pkgs="@xfce-desktop-environment xfce4-terminal"; sentinel="xfce4-session" ;;
    gnome)    pkgs="gnome-shell gnome-terminal nautilus gnome-control-center gnome-tweaks"; sentinel="gnome-shell" ;;
    cinnamon) pkgs="cinnamon nemo gnome-terminal"; sentinel="cinnamon" ;;
    *) echo "unknown desktop id '$id' — leaving KDE in place" >> "$L"; exit 0 ;;
esac

if [ "$id" = hyprland ]; then
    $DNF install dnf5-plugins >> "$L" 2>&1
    dnf -y copr enable sdegler/hyprland >> "$L" 2>&1
fi

echo "--- installing: $pkgs ---" >> "$L"
cp -a /etc/xdg/xfce4 /tmp/vendetta-xfce4
$DNF install $pkgs >> "$L" 2>&1
cp -a /tmp/vendetta-xfce4/. /etc/xdg/xfce4/

if rpm -q "$sentinel" >/dev/null 2>&1; then
    echo "--- '$sentinel' installed; protecting essentials + purging KDE ---" >> "$L"
    dnf -y mark user sddm NetworkManager lightdm greetd >> "$L" 2>&1 || true
    rm -f /etc/dnf/protected.d/plasma-desktop.conf
    dnf -y remove plasma-workspace plasma-desktop >> "$L" 2>&1
    dnf -y autoremove >> "$L" 2>&1
    case "$id" in
        xfce) rm -f /usr/share/wayland-sessions/xfce-wayland.desktop ;;
        gnome|cinnamon) dconf update >> "$L" 2>&1 || true ;;
    esac
    echo "--- lean $id install complete ---" >> "$L"
else
    echo "--- '$sentinel' did NOT install (offline?); KDE left intact ---" >> "$L"
fi
echo "DONE $(date -u)" >> "$L"
exit 0
