#!/bin/sh
if [ -n "$WAYLAND_DISPLAY" ]; then
	sock=$WAYLAND_DISPLAY
	case "$sock" in /*) ;; *) sock="$XDG_RUNTIME_DIR/$sock" ;; esac
	exec pkexec env WAYLAND_DISPLAY="$sock" XDG_RUNTIME_DIR="$XDG_RUNTIME_DIR" \
		QT_QPA_PLATFORM=wayland calamares -d
fi
exec pkexec env DISPLAY="${DISPLAY:-:0}" XAUTHORITY="${XAUTHORITY:-$HOME/.Xauthority}" calamares -d
