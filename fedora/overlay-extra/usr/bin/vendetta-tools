#!/bin/sh
echo "Vendetta Council OS — preinstalled extras on top of Fedora + KDE Plasma:"
echo "  spydirbyte toolkit under /opt/spydir (web apps in the menu, CLI in \$PATH)"
echo "  login managers: sddm (default), lightdm, greetd  —  switch: sudo vendetta-dm <name>"
echo "  CLI: fastfetch btop ripgrep fd bat fzf micro tmux zsh nmap kitty"
echo
echo "spydir CLI tools in PATH:"
for t in /usr/local/bin/spy-* ; do [ -e "$t" ] && echo "  $(basename "$t")"; done
