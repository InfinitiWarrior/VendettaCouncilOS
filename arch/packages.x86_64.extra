# Vendetta Council OS (Arch) — appended to releng's packages.x86_64.
# KDE Plasma is the default/offline desktop (other DEs install on demand at
# install time). All three login managers ship preinstalled.

# --- Xorg / Wayland base + VM guest ---
xorg-server
xorg-xinit
mesa
qemu-guest-agent
spice-vdagent

# --- KDE Plasma 6 (curated, mirror of the Debian set) ---
plasma-desktop
plasma-workspace
plasma-nm
plasma-pa
powerdevil
kscreen
plasma-systemmonitor
bluedevil
kde-gtk-config
kdeplasma-addons
kinfocenter
breeze-gtk
plasma-workspace-wallpapers
# KDE apps
konsole
dolphin
ark
kate
gwenview
okular
spectacle
discover

# --- browser / network / audio ---
firefox
networkmanager
network-manager-applet
pipewire
pipewire-pulse
pipewire-alsa
wireplumber

# --- theming ---
qt6ct
kvantum
papirus-icon-theme
ttf-jetbrains-mono
noto-fonts
noto-fonts-emoji

# --- boot / splash ---
plymouth
grub
efibootmgr
os-prober
dosfstools
mtools

# --- login managers (all three; sddm is the default) ---
sddm
lightdm
lightdm-slick-greeter
greetd
greetd-tuigreet

# --- installer ---
calamares

# --- spydir toolkit build/runtime ---
git
python
python-pip
python-pillow
nodejs
npm

# --- CLI tools (parity with the Debian live set) ---
fastfetch
btop
ripgrep
fd
bat
fzf
micro
tmux
zsh
nmap
kitty
polkit
xdg-utils
xdg-user-dirs
