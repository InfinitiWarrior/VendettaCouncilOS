#!/bin/sh
set -eu
dm="${1:-}"
case "$dm" in
    sddm)    bin=/usr/bin/sddm ;;
    lightdm) bin=/usr/bin/lightdm ;;
    greetd)  bin=/usr/bin/greetd ;;
    *) echo "usage: vendetta-dm <sddm|lightdm|greetd>"; exit 1 ;;
esac
[ "$(id -u)" -eq 0 ] || { echo "run this as root (sudo vendetta-dm $dm)"; exit 1; }
[ -x "$bin" ] || { echo "'$dm' is not installed; leaving the current login manager."; exit 0; }
for d in sddm lightdm greetd; do systemctl disable "$d.service" >/dev/null 2>&1 || true; done
ln -sf "/usr/lib/systemd/system/$dm.service" /etc/systemd/system/display-manager.service
systemctl enable "$dm.service" >/dev/null 2>&1 || true
echo "Login manager set to '$dm'. Reboot to use it."
