#!/bin/sh
set -eu
name=$1; port=$2
src=/opt/spydir/$name
py=/opt/spydir/venv/bin/python
data="${XDG_DATA_HOME:-$HOME/.local/share}/spydir"
app="$data/$name"
url="http://127.0.0.1:$port"

if [ ! -e "$src/app.py" ] || [ ! -x "$py" ]; then
	msg="The spydir toolkit is still installing (first boot). Give it a minute, then try again."
	notify-send "Vendetta Council OS" "$msg" 2>/dev/null \
		|| zenity --info --text="$msg" 2>/dev/null \
		|| kdialog --msgbox "$msg" 2>/dev/null \
		|| xmessage "$msg" 2>/dev/null || true
	exit 0
fi

if [ ! -e "$app/app.py" ]; then
	mkdir -p "$data"
	cp -a "$src" "$app"
fi

up() { "$py" - "$port" <<'PY'
import socket,sys
try: socket.create_connection(("127.0.0.1",int(sys.argv[1])),0.4).close()
except OSError: sys.exit(1)
PY
}

if ! up; then
	( cd "$app" && HOST=127.0.0.1 PORT="$port" DEBUG=0 "$py" app.py \
		>"$app/server.log" 2>&1 & )
	i=0; while [ $i -lt 40 ]; do up && break; sleep 0.5; i=$((i+1)); done
fi

for b in firefox firefox-esr chromium brave; do
	if command -v "$b" >/dev/null 2>&1; then exec "$b" --new-window "$url"; fi
done
exec xdg-open "$url"
