// Vendetta Council OS — minimal centered-sigil splash.
Window.SetBackgroundTopColor(0.016, 0.035, 0.039);     // #04090A
Window.SetBackgroundBottomColor(0.016, 0.035, 0.039);

logo = Image("logo.png");
sprite = Sprite(logo);
sprite.SetX(Window.GetWidth()  / 2 - logo.GetWidth()  / 2);
sprite.SetY(Window.GetHeight() / 2 - logo.GetHeight() / 2);
sprite.SetOpacity(0.85);

fun message_callback(text) {
    img = Image.Text(text, 0.81, 0.90, 0.90);          // #CFE6E6-ish
    msg = Sprite(img);
    msg.SetX(Window.GetWidth() / 2 - img.GetWidth() / 2);
    msg.SetY(Window.GetHeight() * 0.88);
}
Plymouth.SetMessageFunction(message_callback);
