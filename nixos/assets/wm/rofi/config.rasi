configuration {
    modi: "drun,run,window";
    show-icons: true;
    font: "Chakra Petch 12";
    drun-display-format: "{name}";
}

* {
    bg:     #04090A;
    bg-alt: #0A1416;
    fg:     #CFE6E6;
    cyan:   #37E6D8;
    muted:  #5A6E70;
    background-color: transparent;
    text-color:       @fg;
}

window {
    background-color: @bg;
    border:           2px;
    border-color:     @cyan;
    width:            640px;
}
mainbox  { padding: 12px; spacing: 10px; }
inputbar { background-color: @bg-alt; padding: 10px; children: [ prompt, entry ]; }
prompt   { text-color: @cyan; padding: 0 8px 0 0; }
entry    { placeholder: "search"; placeholder-color: @muted; }
listview { lines: 8; spacing: 4px; }
element  { padding: 8px; }
element selected { background-color: @cyan; text-color: @bg; }
element-text { text-color: inherit; }
element-icon { size: 20px; padding: 0 8px 0 0; }
