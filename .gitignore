# --- live-build generated state ---
/.build/
/cache/
/chroot/
/binary/
/chroot.*
/binary.*
/source.*
/build.log
/build-docker.log
/config/binary
/config/bootstrap
/config/chroot
/config/common
/config/source
/config/package-lists/live.list.chroot
/live-image-*
*.iso

# live-build symlinks its own hooks in beside ours — keep only ours
/config/hooks/live/
/config/hooks/normal/*
!/config/hooks/normal/0120-vendetta.hook.chroot
!/config/hooks/normal/0130-vendetta-tools.hook.chroot

# built metapackage (regenerated by packages/build.sh)
/config/packages.chroot/*.deb

# dpkg-buildpackage debris
/packages/*.deb
/packages/*.buildinfo
/packages/*.changes
/packages/vendetta-desktop/debian/files
/packages/vendetta-desktop/debian/*.substvars
/packages/vendetta-desktop/debian/debhelper-build-stamp
/packages/vendetta-desktop/debian/.debhelper/
/packages/vendetta-desktop/debian/vendetta-desktop/

# generated wallpaper scratch (regenerate: brand/make-wallpapers.sh)
/assets/

# Claude Code local session/runtime state
/.claude/

# editor / OS junk
*.swp
*~
.DS_Store
*.orig
