#!/bin/sh
# live-config runtime hook (runs at boot, after the live user is created by
# live-config's own user-setup component). The live user ships with NO
# password at all — fine for autologin, but kscreenlocker still requires a
# real PAM auth to unlock, so a manual/idle lock becomes permanent. Give it
# one known password so it's actually recoverable.
set -e
echo "vendetta:vendetta" | chpasswd
